# Copia este archivo como .env para desarrollo local. No contiene secretos reales.
# Conexión a la base de datos (SQLite local; Docker Compose usa PostgreSQL).
DATABASE_URL=sqlite:///./autofixpro.db
# Carga clientes, usuarios y órdenes de demostración si la base está vacía.
CARGAR_DATOS_DEMO=true
# Tokens de demostración (ADR-012): token:usuario_id:nombre:rol separados por coma.
# Roles válidos: CLIENTE_TITULAR, RESPONSABLE_DE_CUENTA, ASESOR_DE_SERVICIO, TECNICO, COMPRAS, CAJA, GERENTE_DEL_TALLER
TOKENS_DEMO=asesor-demo:ASE-001:Laura Méndez:ASESOR_DE_SERVICIO,tecnico-demo:TEC-001:Jorge Salinas:TECNICO,compras-demo:COM-001:Rosa Treviño:COMPRAS,caja-demo:CAJ-001:Miguel Garza:CAJA,gerente-demo:GER-001:Patricia Leal:GERENTE_DEL_TALLER,cliente-demo:CLI-001:Ana López:CLIENTE_TITULAR,cliente2-demo:CLI-002:Carlos Ramírez:CLIENTE_TITULAR,flotilla-demo:RESP-001:Daniel Ortiz:RESPONSABLE_DE_CUENTA,flotilla2-demo:RESP-002:Mariana Cantú:RESPONSABLE_DE_CUENTA
# Plazo de respuesta en horas (RN-09).
PLAZO_DE_RESPUESTA_HORAS=24
